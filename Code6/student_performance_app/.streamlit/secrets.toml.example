# ============================================================
# Student Performance Assessment System -- secrets template
# ============================================================
# This is the block you paste into
#     Streamlit Community Cloud -> your app -> Settings -> Secrets
# (or into .streamlit/secrets.toml for a local run).
#
# It is TOML, not .env: no quotes around keys, one key per line.
# The real secrets.toml is git-ignored; this template is not, because
# it contains no secrets.
#
# ============================================================

# There is no administrator password: Training Mode is one click away
# from the mode screen (see backend/config.py). Nothing secret is
# required for the app to run, so this template configures behaviour
# only.

# --- STORAGE ----------------------------------------------------
# Community Cloud has no persistent disk: the filesystem is rebuilt on
# every reboot and redeploy. Set this to "0" so the app reports
# session-only history instead of pretending to store it.
# On a VPS or Docker (with a volume) set it to "1" and point
# SPAS_DB_PATH at /data/spas.db.
SPAS_DB_ENABLED = "0"

# Only meaningful when SPAS_DB_ENABLED = "1".
# SPAS_DB_PATH = "/data/spas.db"

# --- MODEL BEHAVIOUR --------------------------------------------
# exam_band is the production target. "cpi" is a rule-reconstruction
# baseline and is refused by the training CLI without an explicit flag.
SPAS_TARGET_DEFINITION = "exam_band"

# quantile (default, balanced thirds) or fixed (legacy 60/80 cut-offs).
SPAS_LABEL_METHOD = "quantile"

# Hyperparameter search and probability calibration during training.
# Both are slow. On a 2.7 GB Community Cloud instance the full six-model
# run takes several minutes; set either to "0" to halve it.
SPAS_TUNING = "1"
SPAS_CALIBRATION = "1"
