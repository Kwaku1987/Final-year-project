# ============================================================
# Student Performance Assessment System -- environment
# ============================================================
# Copy to .env and fill in. NEVER commit the real .env.
#
#     cp .env.example .env
# ============================================================

# Nothing here is secret: there is no administrator password (Training
# Mode is one click from the mode screen -- see backend/config.py).

# --- STORAGE -------------------------------------------------
# SQLite file for assessments + audit trail. Must be on a
# persistent volume in any container deployment.
SPAS_DB_PATH=/data/spas.db

# Set to 0 for a stateless demo (history then lives in the session
# only and is lost on restart).
SPAS_DB_ENABLED=1

# --- MODEL BEHAVIOUR -----------------------------------------
# exam_band (default, honest) or cpi (legacy, circular target)
SPAS_TARGET_DEFINITION=exam_band

# quantile (balanced thirds, default) or fixed (60/80 cut-offs)
SPAS_LABEL_METHOD=quantile

# Hyperparameter search and probability calibration (1/0)
SPAS_TUNING=1
SPAS_CALIBRATION=1

# --- OPTIONAL ------------------------------------------------
# Host/port are set in .streamlit/config.toml; override only if
# your platform requires it.
# STREAMLIT_SERVER_PORT=8501
