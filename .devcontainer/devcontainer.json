{
  "name": "Student Performance Assessment System",
  // Python 3.12 is required, not preferred: xgboost==3.4.1 and shap==0.54.1
  // (see requirements.txt) do not install on 3.11, so a 3.11 image builds a
  // container in which the app cannot start.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "Code6/student_performance_app/app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  // requirements.txt at the repository root is a `-r` include of the app's
  // pinned set, so this installs the same versions CI and Streamlit
  // Community Cloud use.
  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; [ -f requirements.txt ] && pip3 install --user -r requirements.txt; pip3 install --user streamlit; echo '✅ Packages installed and Requirements met'",
  // The two flags are passed on the command line rather than written into
  // .streamlit/config.toml: Codespaces serves the app through a forwarded
  // HTTPS proxy, which CORS/XSRF protection rejects, but the committed
  // config must stay production-safe (see docs/DEPLOYMENT.md §6).
  "postAttachCommand": {
    "server": "cd Code6/student_performance_app && streamlit run app.py --server.address 0.0.0.0 --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}